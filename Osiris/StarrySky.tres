[gd_resource type="ShaderMaterial" load_steps=2 format=2]

[sub_resource type="Shader" id=4]
code = "shader_type canvas_item;

uniform vec4 bg_color : hint_color;
uniform vec2 offset;
uniform float bigStarSlow = 2.0;
uniform float mediumStarSlow = 6.0;
uniform float smallStarSlow = 8.0;

uniform float smallStarAmount = 0.002;
uniform float mediumStarAmount = 0.01;
uniform float bigStarAmount = 0.02;

uniform float pixel_size = 4.0; // Controls pixelation intensity

// Random function for color variations
float rand(vec2 st) {
    return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123);
}

// Function to generate random star colors
vec3 get_star_color(float seed) {
    float t = fract(seed * 13.0); // Randomize between 0-1
    if (t < 0.25) return vec3(1.0, 1.0, 0.8); // Yellowish-White
    if (t < 0.5) return vec3(1.0, 0.6, 0.8);  // Pink
    if (t < 0.75) return vec3(0.6, 1.0, 0.6); // Greenish
    return vec3(1.0, 1.0, 1.0); // White
}

void fragment() {
    vec2 screen_pos = SCREEN_UV / SCREEN_PIXEL_SIZE;

    // Pixelate the coordinates
    vec2 pixel_uv = floor(screen_pos / pixel_size) * pixel_size;

    vec2 normCoordBig = pixel_uv + floor(offset / bigStarSlow);
    vec2 normCoordMedium = pixel_uv + floor(offset / mediumStarSlow);
    vec2 normCoordSmall = pixel_uv + floor(offset / smallStarSlow);

    float color_intensity = 0.0;
    vec3 star_color = vec3(1.0); // Default white

    // Draw Medium Stars
    float size = 20.0;
    float prob = 1.0 - mediumStarAmount;
    vec2 pos = floor(1.0 / size * normCoordMedium);
    float starValue = rand(pos);

    if (starValue > prob) {
        vec2 center = size * pos + vec2(size, size) * 0.5;
        float t = 0.9 + 0.2 * sin(TIME * 8.0 + (starValue - prob) / (1.0 - prob) * 45.0);
        color_intensity = 1.0 - distance(normCoordMedium.xy, center) / (0.5 * size);
        color_intensity *= t / (abs(normCoordMedium.y - center.y)) * t / (abs(normCoordMedium.x - center.x));
        star_color = get_star_color(starValue);
    }

    // Draw Big Stars
    size = 100.0;
    prob = 1.0 - bigStarAmount;
    pos = floor(1.0 / size * normCoordBig);
    starValue = rand(pos);

    if (starValue > prob) {
        vec2 center = size * pos + vec2(size, size) * 0.5;
        float t = 0.9 + 0.2 * sin(TIME * 8.0 + (starValue - prob) / (1.0 - prob) * 45.0);
        color_intensity = 1.0 - distance(normCoordBig.xy, center) / (0.5 * size);
        color_intensity *= t / (abs(normCoordBig.y - center.y)) * t / (abs(normCoordBig.x - center.x));
        star_color = get_star_color(starValue);
    }

    // Draw Small Stars
    if (rand(normCoordSmall / 20.0) > 1.0 - smallStarAmount) {
        float r = rand(normCoordSmall);
        color_intensity = r * (0.85 * sin(TIME * (r * 5.0) + 720.0 * r) + 0.95);
        star_color = get_star_color(r);
    }

    // Apply star colors
    COLOR = vec4(star_color * color_intensity, color_intensity) + bg_color;
}
"

[resource]
shader = SubResource( 4 )
shader_param/bg_color = Color( 0.121569, 0.121569, 0.121569, 1 )
shader_param/offset = null
shader_param/bigStarSlow = 2.0
shader_param/mediumStarSlow = 6.0
shader_param/smallStarSlow = 8.0
shader_param/smallStarAmount = 0.01
shader_param/mediumStarAmount = 0.01
shader_param/bigStarAmount = 0.02
shader_param/pixel_size = 4.0
